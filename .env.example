# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xs_share

# Apps (local dev: uncommon 5xxx ports)
NEXT_PUBLIC_APP_URL=http://localhost:5180
NEXT_PUBLIC_API_URL=http://localhost:5181
API_PORT=5181
WEB_ORIGIN=http://localhost:5180

# Auth
SESSION_SECRET=change-me-to-a-long-random-string
AUTH_DEV_LOGIN=true
COOKIE_SECURE=false
DISABLE_WORKERS=false

# Wallet / chain (mock for local & tests; tron for real TRC20 deposits)
CHAIN_ADAPTER=mock
# TRON_API_URL=https://api.trongrid.io
# TRON_API_KEY=
# TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# TRON_DEPOSIT_XPUB= # watch-only xpub exported at m/44'/195'/0'/0; derive /{index} for user deposit addresses
# NEXT_PUBLIC_TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# OAuth (optional for local dev; Dev Login still works)
# Callback URLs: http://localhost:5181/v1/auth/google/callback
#                http://localhost:5181/v1/auth/x/callback
OAUTH_CALLBACK_BASE_URL=http://localhost:5181
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_NAME=
