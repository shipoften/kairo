{
  "name": "xs-share",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate --filter=@xs-share/db",
    "db:migrate": "turbo run db:migrate --filter=@xs-share/db",
    "db:ensure": "bun run --filter @xs-share/db db:ensure",
    "db:setup": "bun run db:ensure && bun run db:migrate",
    "db:verify": "bun run --filter @xs-share/db db:verify",
    "db:studio": "turbo run db:studio --filter=@xs-share/db",
    "test": "bun test apps/api",
    "test:e2e": "bunx playwright test --config apps/web/playwright.config.ts"
  },
  "devDependencies": {
    "turbo": "^2.10.7",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  }
}
