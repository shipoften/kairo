{
  "name": "@xs-share/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "echo \"db lint placeholder\"",
    "typecheck": "tsc --noEmit",
    "db:ensure": "bun --env-file=../../.env run scripts/ensure-database.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:verify": "bun --env-file=../../.env run scripts/verify-database.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@xs-share/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
